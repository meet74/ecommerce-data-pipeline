# Source APIs. Defaults point at the bundled mock server (make serve).
SHOPIFY_BASE_URL=http://127.0.0.1:8100/shopify
SHOPIFY_ACCESS_TOKEN=shpat_mock_token
STRIPE_BASE_URL=http://127.0.0.1:8100/stripe
STRIPE_API_KEY=sk_test_mock_key

# Warehouse: duckdb (default) or postgres
WAREHOUSE_TARGET=duckdb
DUCKDB_PATH=data/warehouse.duckdb
# Used when WAREHOUSE_TARGET=postgres (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ecommerce

# Extraction behaviour
PAGE_SIZE=250
MAX_RETRIES=6
BACKOFF_BASE_SECONDS=0.5
LOOKBACK_SECONDS=120
LANDING_DIR=data/landing

# Outputs
REPORT_DIR=reports
SLACK_WEBHOOK_URL=

# Mock server only
MOCK_SEED=42
MOCK_RATE_LIMIT_PER_SEC=60
MOCK_ERROR_RATE=0.01
MOCK_PORT=8100
